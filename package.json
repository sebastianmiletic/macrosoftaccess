{
  "name": "macrosoft-access",
  "version": "1.2.0",
  "description": "A local-first visual relational database studio for macOS",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "vite build",
    "dist:mac": "npm run build && electron-builder --mac",
    "check": "node tests/metadata.test.mjs && node tests/compatibility.test.mjs && vite build"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "vite": "^6.2.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.macrosoft.access",
    "productName": "Macrosoft Access",
    "directories": {
      "output": "release"
    },
    "files": [
      "renderer-dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
